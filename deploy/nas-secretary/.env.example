# Keep this volume name stable. It stores authentication, installation identity,
# configuration, state databases, session history, skills, and plugins.
CODEX_HOME_VOLUME=codex-secretary-home

# Use an absolute directory on the NAS owned by CODEX_UID:CODEX_GID.
SECRETARY_WORKSPACE_PATH=/srv/codex-secretary/workspace
# Remote's new-chat flow creates projects under this directory. Keep this
# narrow bind mount because the rest of /home/codex remains read-only.
SECRETARY_DOCUMENTS_PATH=/srv/codex-secretary/documents

CODEX_UID=1000
CODEX_GID=1000
# Set from `docker info --format '{{.Architecture}}'` on the deployment host.
CODEX_TARGET_ARCH=amd64
CODEX_HOSTNAME=secretary-nas
# Replace SOURCE_COMMIT with `git rev-parse --short=12 HEAD` before building.
# Keeping each built image under a unique tag makes rollback possible.
CODEX_IMAGE_TAG=git-SOURCE_COMMIT
CARGO_BUILD_JOBS=1
TZ=America/Denver

# Keep setuid support disabled when the host allows unprivileged user
# namespaces. Follow the documented host-specific fallback before changing
# these values.
CODEX_BWRAP_SUPPORT_SETUID=0
CODEX_LINUX_SANDBOX_DISABLE_SECCOMP=0
CODEX_NO_NEW_PRIVILEGES=true
CODEX_APPARMOR_PROFILE=docker-default

# Keep the custom profile on hosts with seccomp support. If Docker reports that
# seccomp is not enabled in the host kernel, set this to seccomp=unconfined.
CODEX_SECCOMP_SECURITY_OPT=seccomp=./bubblewrap-seccomp.json

CODEX_LOG_MAX_SIZE=20m
CODEX_LOG_MAX_FILES=5
